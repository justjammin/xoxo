{
  "name": "xoxo-eval",
  "version": "0.1.0",
  "description": "Compare any two models running on headless Claude Code or Codex with isolated fixtures, deterministic assertions, and blind judging.",
  "keywords": [
    "ai-evals",
    "claude-code",
    "codex",
    "model-comparison",
    "mcp"
  ],
  "homepage": "https://github.com/justjammin/xoxo#readme",
  "bugs": {
    "url": "https://github.com/justjammin/xoxo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justjammin/xoxo.git"
  },
  "files": [
    "dist/web",
    "examples",
    "skills",
    "src"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "xoxo": "src/interfaces/cli/main.ts"
  },
  "scripts": {
    "dev": "bun run src/interfaces/cli/main.ts dev",
    "serve": "bun run src/interfaces/cli/main.ts serve",
    "xoxo": "bun run src/interfaces/cli/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "bun test && tsc --noEmit && vite build",
    "prepack": "bun run build",
    "site:dev": "WRANGLER_WRITE_LOGS=false wrangler dev --config wrangler.jsonc",
    "site:build": "WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --config wrangler.jsonc --outdir dist/site-worker",
    "site:deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.0",
    "@elysiajs/static": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "elysia": "^1.4.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.3.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.181.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.33.1"
  }
}
